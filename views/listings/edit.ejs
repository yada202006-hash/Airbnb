<% layout("/layouts/boilerplate") %>
    <body>
        <h3>Edit your List</h3>
    <form method="POST" action="/listing/<%=listing._id%>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
        <div>
            <label for="title" class="form-label">Title</label>
            <input type="text" name="listing[title]" value="<%=listing.title%>" class="form-control" required>
            <div class="valid-feedback">good title</div>
            <div class="invalid-feedback">enter title</div>
        </div>
        <br/>
        <div>
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" class="form-control" required><%=listing.description%></textarea>
            <div class="valid-feedback">good description</div>
            <div class="invalid-feedback">enter description</div>
        </div>
        <br/>
        <div>
            <label for="image" class="form-label">Upload new Image</label>
            <input type="file" name="listing[image]"  class="form-control" required>

            <div class="valid-feedback">good image URL</div>
            <div class="invalid-feedback">enter image URL</div>
        </div>
        <br/>
        <div class="row">
            <div class="md-3 col-md-8">
                <label for="price" class="form-label">Price</label>
                <input type="number" name="listing[price]" value="<%=listing.price%>" class="form-control" required>
                <div class="valid-feedback">good price</div>
                <div class="invalid-feedback">enter price</div>
            </div>
            <br/>
            <div class="md-3 col-md-8">
                <label for="location" class="form-label">Location</label>
                <input type="text" name="listing[location]" value="<%=listing.location%>" class="form-control" required>
                <div class="valid-feedback">good location</div>
                <div class="invalid-feedback">enter location</div>
            </div>
        </div>
        <br/>
        <div>
            <label for="country" class="form-label">Country</label>
            <input type="text" name="listing[country]" value="<%=listing.country%>" class="form-control" required>
            <div class="valid-feedback">good country</div>
            <div class="invalid-feedback">enter country</div>
        </div>
        <br/>
        <button class="btn btn-dark add-btn">Done</button>
        <br/><br/>
    </form>
    </body>